@article{hassan2026caa,
  abbr        = {CIBM},
  bibtex_show = {true},
  selected    = {true},
  title       = {Context-Aware Asymmetric Ensembling for Interpretable Retinopathy of Prematurity Screening via Active Query and Vascular Attention},
  author      = {Hassan, Md. Mehedi and Hasan, Taufiq},
  journal     = {Computers in Biology and Medicine},
  volume      = {216},
  pages       = {111945},
  year        = {2026},
  publisher   = {Elsevier},
  doi         = {10.1016/j.compbiomed.2026.111945},
  arxiv       = {2602.05208},
  code        = {https://github.com/mubid-01/CAA_Ensemble},
  preview     = {hassan2026caa.jpg},
  abstract    = {Retinopathy of Prematurity (ROP) is among the major causes of preventable childhood blindness. Automated screening remains challenging, primarily due to limited data availability and the complexity of the condition involving both structural staging and microvascular abnormalities. We propose the Context-Aware Asymmetric Ensemble (CAA Ensemble), which simulates clinical reasoning through two specialized streams: a Multi-Scale Active Query Network (MS-AQNet) that uses clinical context as dynamic query vectors to guide localization of the fibrovascular ridge, and VascuMIL, which encodes Vascular Topology Maps within a gated multiple instance learning network to identify vascular tortuosity. Tested on a highly imbalanced cohort of 188 infants (6004 images), the framework achieved a Macro F1-score of 0.93 for broad ROP staging and an AUC of 0.996 for Plus Disease detection, with counterfactual attention heatmaps and vascular threat maps for interpretability.}
}

@article{hassan2025synapse,
  abbr        = {arXiv},
  bibtex_show = {true},
  selected    = {true},
  title       = {SYNAPSE-Net: A Unified Framework with Lesion-Aware Hierarchical Gating for Robust Segmentation of Heterogeneous Brain Lesions},
  author      = {Hassan, Md. Mehedi and Alam, Shafqat and Seam, Shahriar Ahmed and Ahmed, Maruf},
  journal     = {arXiv preprint arXiv:2510.26961 (under review)},
  year        = {2025},
  arxiv       = {2510.26961},
  code        = {https://github.com/mubid-01/SYNAPSE-Net-pre},
  preview     = {hassan2025synapse.jpg},
  abstract    = {Automatic segmentation of diverse heterogeneous brain lesions using multi-modal MRI is challenging, mainly because of the limited generalizability and high prediction variance of pathology-specific deep learning models. We propose SYNAPSE-Net, a unified multi-stream framework combining convolutional encoders, Swin Transformer global context modeling, cross-modal attention fusion and a hierarchical gated decoder, trained with a variance-aware strategy. Validated on WMH MICCAI 2017, ISLES 2022 and BraTS 2020, it achieved a DSC of 0.831 and HD95 of 3.03 on WMH, the lowest HD95 of 9.69 on ISLES 2022, and the highest tumor core DSC of 0.8651 on BraTS 2020.}
}

@inproceedings{hassan2026cough,
  bibtex_show = {true},
  selected    = {true},
  title       = {An Integrated Edge-AI Framework for Interpretable Respiratory Screening via Adaptive Cough Analysis in Low-Resource Settings},
  author      = {Hassan, Md. Mehedi and Chowdhury, Fariha Hasan and Shotota, Sumaiya Islam and Akter, Nafisa},
  booktitle   = {2nd International Conference on Advances in Computing, Communication, Electrical, and Smart Systems (accepted)},
  year        = {2026},
  publisher   = {IEEE},
  preview     = {hassan2026cough.jpg},
  abstract    = {We propose a framework for classifying pneumonia, pertussis, bronchitis and healthy coughs. A dual-threshold hysteresis gating technique isolates cough events from noise, which are converted into log-Mel spectrograms for an EfficientNet-B1 classifier. Using nested, subject-aware cross-validation on 426 participants, the system achieved AUCs of 1.00 for healthy controls, 0.99 for pertussis, 0.94 for bronchitis and 0.92 for pneumonia, with 85% patient-level accuracy. The pipeline runs fully offline in an Android application.}
}
